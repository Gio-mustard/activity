# ---------------------------------------------------------------
# Amai Activity - variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# ---------------------------------------------------------------

# Cadena de conexion de MongoDB Atlas.
# Atlas > Database > Connect > Drivers. Recuerda URL-encodear la contrasena.
MONGODB_URI="mongodb+srv://USUARIO:PASSWORD@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=amai"

# Nombre de la base de datos dentro del cluster.
MONGODB_DB="amai_activity"

# Puerto del servidor, SOLO para desarrollo local.
# No la definas en Render: la plataforma inyecta la suya y si la pisas, su
# router busca la app en un puerto donde no esta.
PORT=3000

# Evita que mongodb-memory-server (solo para pruebas) descargue 141 MB de
# binarios al instalar. En Render ahorra tiempo de build; en local, ponlo en 0
# la primera vez que corras `npm test` para que si descargue el binario.
MONGOMS_DISABLE_POSTINSTALL=1
